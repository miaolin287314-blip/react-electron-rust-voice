{
    "name": "fjwh-desktop",
    "version": "0.0.1",
    "main": "dist/electron/main.js",
    "scripts": {
        "dev": "npm run build:electron && concurrently -k -n VITE,ELECTRON \"npm:dev:vite\" \"npm:dev:electron\"",
        "dev:vite": "vite --config vite.config.ts",
        "dev:electron": "wait-on http://127.0.0.1:5173 && cross-env NODE_ENV=development VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
        "build": "npm run typecheck && npm run build:electron && vite build",
        "build:electron": "tsc -p tsconfig.json",
        "typecheck": "tsc -p ui/tsconfig.json --noEmit",
        "start": "cross-env NODE_ENV=production electron .",
        "preview": "vite preview --host 127.0.0.1"
    },
    "dependencies": {
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "react-router-dom": "^7.6.2",
        "zustand": "^5.0.5"
    },
    "devDependencies": {
        "@types/node": "^22.15.30",
        "@types/react": "^19.1.6",
        "@types/react-dom": "^19.1.6",
        "@vitejs/plugin-react": "^4.5.0",
        "concurrently": "^9.1.2",
        "cross-env": "^7.0.3",
        "electron": "^44.5.1",
        "typescript": "^7.0.2",
        "vite": "^6.3.5",
        "wait-on": "^8.0.3"
    }
}
